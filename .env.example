# Arc Testnet public RPC. Never put wallet private keys in this file.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional server-only RPC override for balance reads. Falls back to public Arc endpoints.
ARC_RPC_URL=

# Public Privy App ID from the Privy Dashboard.
# Enable Google, email, and wallet login methods and add local/production origins.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional live The Graph endpoint for the standardized Arc yield subgraph.
# Keep API keys server-side. Configure either the complete Studio URL...
ARC_YIELD_SUBGRAPH_URL=

# ...or a decentralized Network API key + Subgraph ID pair.
GRAPH_API_KEY=
ARC_YIELD_SUBGRAPH_ID=
